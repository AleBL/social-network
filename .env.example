NEO4J_URI=neo4j+s://<your-database-uri>
NEO4J_USER=neo4j
NEO4J_PASSWORD=strongpassword
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=3000
FRONTEND_PORT=8080
# Comma-separated list of frontend origins allowed by the backend CORS policy
CORS_ORIGIN=http://localhost:8080
# Requests per client IP per 15 minutes under /api (writes have their own, lower limit)
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=30
# Express "trust proxy": leave empty locally, "1" behind one proxy (Render)
TRUST_PROXY=
